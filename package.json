{
  "name": "terroir",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:contracts": "vitest run src/test/contracts src/lib/api/errors.contract.test.ts src/lib/api/validation.contract.test.ts src/lib/api/handler.contract.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker": "tsx src/worker/index.ts",
    "verify:api-contract": "node scripts/verify-api-contract.mjs",
    "generate:product-conformance": "node scripts/generate-product-contract-conformance.mjs --write",
    "verify:product-conformance": "node scripts/generate-product-contract-conformance.mjs --check",
    "verify:feature-ledger": "node scripts/verify-feature-ledger.mjs",
    "eval:vwp": "node scripts/run-vwp-evals.mjs",
    "snapshot": "node scripts/build-schema-snapshot.mjs",
    "snapshot:check": "node scripts/build-schema-snapshot.mjs && git diff --exit-code supabase/schema.snapshot.sql",
    "types:gen": "node scripts/generate-supabase-types.mjs",
    "types:check": "node scripts/check-types-drift.mjs",
    "downs:check": "node scripts/check-down-migrations.mjs",
    "drill:restore": "node scripts/restore-drill.mjs",
    "manifest:check": "node scripts/check-migration-manifest.mjs",
    "atlas:geo": "tsx scripts/build-atlas-geo.ts",
    "supabase:seed:local": "node scripts/seed-local-supabase.mjs",
    "supabase:seed:local:apply": "node scripts/seed-local-supabase.mjs --confirm",
    "supabase:seed:local:teardown": "node scripts/seed-local-supabase.mjs --teardown --confirm"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@azure-rest/ai-document-intelligence": "^1.1.0",
    "@azure/core-auth": "^1.10.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/nextjs": "^10.71.0",
    "@supabase/ssr": "0.10.2",
    "@supabase/supabase-js": "2.103.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.12",
    "puppeteer": "^24.43.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "4.1.4",
    "ajv": "^8.18.0",
    "d3-geo": "^3.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^20.9.0",
    "js-yaml": "^4.3.2",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.4",
    "world-atlas": "^2.0.2"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "^7.29.1",
      "basic-ftp": "^5.3.1",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9",
      "fast-uri": "^3.1.5",
      "ip-address": "^10.3.1",
      "nanoid@3": "^3.3.18",
      "postcss": "^8.5.23",
      "sharp": "^0.35.0",
      "uuid": "^11.1.1",
      "vite": "^8.0.16",
      "ws": "^8.21.0"
    }
  }
}
