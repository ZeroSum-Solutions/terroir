# Copy to .env.local and fill in. Never commit real keys.

# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public origin of this deployment. Required in production: auth email links
# are built from this value, never request Host/X-Forwarded-Host headers.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Manual staging deploys only: pin this to the exact source commit so the
# staging smoke can bind the running container when Railway has no Git source
# metadata. Railway-connected deploys use RAILWAY_GIT_COMMIT_SHA instead.
TERROIR_RELEASE_SHA=

# Server-only — leave blank in .env.local until needed
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — for invoice structuring (Phase 1)
ANTHROPIC_API_KEY=

# Azure Document Intelligence — required for invoice scanning
# Get from Azure Portal → Document Intelligence → Keys and Endpoint
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=

# INT-014: REQUIRED IN ALL ENVIRONMENTS (including local dev) post BND-003.
# Signs the active_restaurant_id cookie that requireMembership +
# getAuthContext read to resolve which restaurant a multi-membership user
# is currently acting on. Must be at least 16 characters of random entropy.
# Generate with `openssl rand -hex 32` and store as a Railway secret in
# production. The app throws unconditionally at request time if this env
# var is absent or shorter than 16 chars — there is no dev fallback.
ACTIVE_RESTAURANT_COOKIE_SECRET=

# Real provider E2E — CI/staging only, never a production target. These are
# intentionally blank: values and the service-role key belong in isolated CI
# secrets, not in a local env file or source control. The test rejects a target
# without "staging" in its hostname and refuses a Supabase URL matching the
# configured production safety pattern.
AUTH_E2E_ENABLED=
AUTH_E2E_BASE_URL=
AUTH_E2E_MAILBOX_URL=
AUTH_E2E_MAILBOX_USERNAME=
AUTH_E2E_MAILBOX_PASSWORD=
AUTH_E2E_EMAIL_DOMAIN=
AUTH_E2E_RUN_ID=
AUTH_E2E_SUPABASE_URL=
AUTH_E2E_PRODUCTION_SUPABASE_URL_PATTERN=
AUTH_E2E_SERVICE_ROLE_KEY=

# Loopback-only local seeded browser tests. Never point these at staging or
# production. The test additionally rejects a non-loopback Supabase URL.
LOCAL_E2E_ENABLED=
LOCAL_SEED_USER_EMAIL=owner+local@terroir.test
LOCAL_SEED_USER_PASSWORD=

# Sentry — BND-032 / INT-010. Leave blank in dev if you don't want
# errors reported while working locally.
# Server-side DSN:
SENTRY_DSN=
# Client-side DSN. This IS inlined into the browser bundle by design —
# the DSN is a public identifier, not a secret.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time token for source-map uploads. Create under Sentry
# User Settings → Auth Tokens, scopes: project:releases + org:read.
# Missing token = no upload, build still succeeds.
SENTRY_AUTH_TOKEN=
# Optional: override environment label shown in Sentry. Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional: traces sample rate (0..1). Default 0.1 — tune up for
# performance debugging, down to control cost at scale.
SENTRY_TRACES_SAMPLE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE=

# Price comparison: threshold (0..1) above which purchase variance and
# consecutive market-price shifts are highlighted. Default 0.10 = 10%.
PRICE_VARIANCE_HIGHLIGHT_THRESHOLD=0.10

# Wine-Searcher — optional retail-price provider. Leave blank to keep pricing
# intelligence visibly degraded; the health endpoint never calls this billed API.
WINE_SEARCHER_API_KEY=

# Non-production observability drill. Store only a SHA-256 digest on the
# service; provide the raw token to `pnpm drill:alerts` through the invoking
# process environment. The health route refuses this mechanism in production.
OBSERVABILITY_DRILL_ENABLED=
OBSERVABILITY_DRILL_TOKEN_SHA256=
ALERT_DRILL_BASE_URL=
ALERT_DRILL_TOKEN=

# TER-021C isolated worker. Give the worker service only the non-production
# Supabase URL and service-role key for its own environment. Never copy the
# production service-role key into staging. PORT is injected by Railway.
WORKER_ID=
WORKER_CONCURRENCY=4
WORKER_CLAIM_LIMIT=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_DATABASE_TIMEOUT_MS=10000
WORKER_DATABASE_ERROR_BACKOFF_MAX_MS=30000
WORKER_JOB_TIMEOUT_MS=900000
WORKER_SHUTDOWN_GRACE_MS=25000
WORKER_BACKOFF_BASE_SECONDS=30
WORKER_QUEUE_HEALTH_INTERVAL_MS=10000
WORKER_HEALTH_STALE_AFTER_MS=60000
WORKER_QUEUE_AGE_ALERT_MS=300000
WORKER_DEAD_LETTER_ALERT_COUNT=1

# TER-021E rollback flag. Missing or any value other than literal 1 keeps the
# synchronous PDF path. Enable only after migration 0077 and the staging worker
# handler are healthy; disable before draining or rolling back the worker.
PDF_WORKER_ENABLED=0

# TER-021G dependency-gated rollout flags. Keep both at 0 until TER-021F's
# invoice-OCR soak is recorded and the wine-enrichment staging drill passes.
# Enable the handler first, inspect registered_handlers and the queue, then
# enable web enqueues. Disable web enqueues before draining or rollback.
WINE_ENRICHMENT_HANDLER_ENABLED=0
WINE_ENRICHMENT_WORKER_ENABLED=0
