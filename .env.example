# Copy to .env.local and fill in. Never commit real keys.

# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public deployment origin. Required in production so auth email links never
# derive trust from request Host or X-Forwarded-Host headers.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — leave blank in .env.local until needed
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — for invoice structuring (Phase 1)
ANTHROPIC_API_KEY=

# Azure Document Intelligence — required for invoice scanning
# Get from Azure Portal → Document Intelligence → Keys and Endpoint
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=

# INT-014: REQUIRED IN ALL ENVIRONMENTS (including local dev) post BND-003.
# Signs the active_restaurant_id cookie that requireMembership +
# getAuthContext read to resolve which restaurant a multi-membership user
# is currently acting on. Must be at least 16 characters of random entropy.
# Generate with `openssl rand -hex 32` and store as a Railway secret in
# production. The app throws unconditionally at request time if this env
# var is absent or shorter than 16 chars — there is no dev fallback.
ACTIVE_RESTAURANT_COOKIE_SECRET=

# Dev-only: enable /api/dev-login with a signed-in email. Server-only.
# MUST NOT use the NEXT_PUBLIC_ prefix — that would inline the value into
# the client bundle and let any browser invoke the bypass. Leave blank in
# production; the endpoint hard-404s when NODE_ENV=production anyway.
DEV_BYPASS_EMAIL=

# Real provider E2E — isolated CI/staging only, never a production target.
# Keep values and the staging-only service-role key in approved CI secrets.
AUTH_E2E_ENABLED=
AUTH_E2E_BASE_URL=
AUTH_E2E_MAILBOX_URL=
AUTH_E2E_MAILBOX_USERNAME=
AUTH_E2E_MAILBOX_PASSWORD=
AUTH_E2E_EMAIL_DOMAIN=
AUTH_E2E_RUN_ID=
AUTH_E2E_SUPABASE_URL=
AUTH_E2E_PRODUCTION_SUPABASE_URL_PATTERN=
AUTH_E2E_SERVICE_ROLE_KEY=

# Sentry — BND-032 / INT-010. Leave blank in dev if you don't want
# errors reported while working locally.
# Server-side DSN:
SENTRY_DSN=
# Client-side DSN. This IS inlined into the browser bundle by design —
# the DSN is a public identifier, not a secret.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time token for source-map uploads. Create under Sentry
# User Settings → Auth Tokens, scopes: project:releases + org:read.
# Missing token = no upload, build still succeeds.
SENTRY_AUTH_TOKEN=
# Optional: override environment label shown in Sentry. Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional: traces sample rate (0..1). Default 0.1 — tune up for
# performance debugging, down to control cost at scale.
SENTRY_TRACES_SAMPLE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE=

# Price comparison: threshold (0..1) above which variance rows are highlighted.
# Default 0.10 = 10%. Set lower to catch more wines, higher to narrow.
PRICE_VARIANCE_HIGHLIGHT_THRESHOLD=0.10
