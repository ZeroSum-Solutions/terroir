# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
# BND-030: scoring sweep output from scripts/test-invoices.ts
test-results*.json

# next.js
/.next/
/out/
.next-dev.log
.next-dev.pid

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# LWIN data (large CSV, not committed)
scripts/lwin.csv

# P1 — generated bulk fixtures (deterministic, regenerate via
# scripts/fixtures/generate-partner-cellar.mjs). The small golden sample in
# fixtures/ (not fixtures/generated/) IS committed.
/fixtures/generated/

# code-council per-project enablement + cross-session state
# (per-project plugin opt-in; runtime state mutates between bundles)
/.claude/settings.json
/.council/

.playwright-cli/
.playwright/
# agent/build runtime artifacts (2026-06-04)
.claude/handoffs/
.zeroforge-debris/
.zeroforge/
supabase/.temp/
scratchpad/

# harvest-wine-imagery.mjs cache — ~8 MB of source metadata, re-fetchable and
# not a build input. seed-catalog-imagery.mjs reads it from here by default.
/.wine-imagery/

# audit-wine-imagery.mjs run artifacts — ~2 MB of screenshots plus a results
# json, regenerated by every run and not a build input.
/docs/screenshots/imagery-audit/
