# Local Supabase stack (see docs/runbooks/local-stack.md).
#
# These are the default supabase-cli local dev values for this repo's
# `supabase/config.toml` (project_id "terroir-vw-local", ports 573xx to
# avoid colliding with other local Supabase stacks on this machine). The
# anon/publishable and service-role keys below are the well-known
# supabase-cli local defaults — fine to commit, NOT production secrets.
#
# Copy to .env.local (gitignored) and run scripts/local/dev-stack.sh to
# bring the whole stack up. NEVER point these at a hosted Supabase project.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:57321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Public deployment origin. Required in production so auth email links never
# derive trust from request Host or X-Forwarded-Host headers. Matches the
# port used to boot `pnpm dev -p 3100` locally.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Server-only. Local supabase-cli default service_role JWT (signed with the
# well-known local JWT_SECRET) — safe to commit, only valid against a local
# stack that uses the same default JWT_SECRET.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Anthropic — for invoice structuring (Phase 1). Left unset for local dev;
# only the AI-extraction routes need it, and they fail closed with
# "not_configured" rather than throwing at boot.
ANTHROPIC_API_KEY=

# Azure Document Intelligence — required for invoice scanning. Left unset
# for local dev; the scanner routes fail closed with "not_configured".
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=

# INT-014: REQUIRED IN ALL ENVIRONMENTS (including local dev) post BND-003.
# Signs the active_restaurant_id cookie. Generate a fresh one with
# `openssl rand -hex 32` for your own checkout if you want (any random
# string >=16 chars works) — this is just a local dev placeholder, not a
# secret worth protecting.
ACTIVE_RESTAURANT_COOKIE_SECRET=c0ef9136e5ba2fba0974494b9a41a49821d01f9405702f97716ae5301b71f9f7

# Dev-only: enable /api/dev-login with a signed-in email. Server-only.
# Must match the user scripts/local/seed-local.mjs creates.
DEV_BYPASS_EMAIL=devlocal@terroir.test

# Real provider E2E — isolated CI/staging only, never used against this
# local stack. Leave blank.
AUTH_E2E_ENABLED=
AUTH_E2E_BASE_URL=
AUTH_E2E_MAILBOX_URL=
AUTH_E2E_MAILBOX_USERNAME=
AUTH_E2E_MAILBOX_PASSWORD=
AUTH_E2E_EMAIL_DOMAIN=
AUTH_E2E_RUN_ID=
AUTH_E2E_SUPABASE_URL=
AUTH_E2E_PRODUCTION_SUPABASE_URL_PATTERN=
AUTH_E2E_SERVICE_ROLE_KEY=

# Sentry — left blank for local dev (Sentry.init with no DSN is a no-op).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE=

# Price comparison: threshold (0..1) above which variance rows are
# highlighted. Defaults to 0.10 in code if unset.
PRICE_VARIANCE_HIGHLIGHT_THRESHOLD=0.10
